# ---- FetchStream Pro API - Environment Configuration ----
# Every value has a sane default. Copy to .env (or set in your host dashboard).

# Server
PORT=3000
NODE_ENV=production

# Upstream sources (only override if a source changes domain)
ANIMESALT_BASE=https://animesalt.cx
TOONSTREAM_BASE=https://toonstream.vip

# TMDb API key (get your own free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Lazy-fetch cache tuning (milliseconds)
CACHE_TTL_MS=300000            # default TTL: 5 minutes
CACHE_TTL_STREAMS_MS=120000    # stream links expire faster: 2 minutes
CACHE_TTL_TMDB_MS=86400000     # TMDb artwork: 24 hours
CACHE_MAX_ENTRIES=500

# Upstream fetch behaviour
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_MAX_REDIRECTS=5
UPSTREAM_RETRIES=2
MAX_CONCURRENT_UPSTREAM=8

# API protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# CORS - comma separated origins, or * for open
CORS_ORIGINS=*
